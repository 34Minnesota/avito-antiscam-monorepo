{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API сервиса AntiScam.",
        "title": "AntiScam API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Проверка состояния сервиса",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/v1/attempts": {
            "post": {
                "security": [
                    {
                        "SessionID": []
                    }
                ],
                "description": "Создаёт новую попытку прохождения сценария.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attempts"
                ],
                "summary": "Начать попытку",
                "parameters": [
                    {
                        "description": "Данные сценария",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httptransport.StartAttemptRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/attempts/{attemptID}/choice": {
            "post": {
                "security": [
                    {
                        "SessionID": []
                    }
                ],
                "description": "Отправляет выбор пользователя для текущей сцены.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attempts"
                ],
                "summary": "Сделать выбор в попытке",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID попытки",
                        "name": "attemptID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Выбор пользователя",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httptransport.ChoiceRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/attempts/{attemptID}/summary": {
            "get": {
                "security": [
                    {
                        "SessionID": []
                    }
                ],
                "description": "Возвращает итоговую информацию по попытке пользователя.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attempts"
                ],
                "summary": "Получить результат попытки",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID попытки",
                        "name": "attemptID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/auth/login": {
            "post": {
                "description": "Выполняет вход по email и паролю и создаёт сессию.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Вход в систему",
                "parameters": [
                    {
                        "description": "Учётные данные",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httptransport.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httptransport.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/auth/logout": {
            "post": {
                "security": [
                    {
                        "SessionID": []
                    }
                ],
                "description": "Завершает текущую сессию.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Выход из системы",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/auth/register": {
            "post": {
                "description": "Создаёт пользователя и связанную с ним сессию.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Регистрация пользователя",
                "parameters": [
                    {
                        "description": "Данные для регистрации",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httptransport.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/httptransport.RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/progress": {
            "get": {
                "security": [
                    {
                        "SessionID": []
                    }
                ],
                "description": "Возвращает общий прогресс текущего авторизованного пользователя по сценариям.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "progress"
                ],
                "summary": "Получить прогресс пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httptransport.progressResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/scenarios": {
            "get": {
                "security": [
                    {
                        "SessionID": []
                    }
                ],
                "description": "Возвращает доступные пользователю сценарии.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "training"
                ],
                "summary": "Получить список сценариев",
                "parameters": [
                    {
                        "enum": [
                            "buyer",
                            "seller"
                        ],
                        "type": "string",
                        "description": "Роль пользователя",
                        "name": "role",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/users/me": {
            "get": {
                "security": [
                    {
                        "SessionID": []
                    }
                ],
                "description": "Возвращает данные пользователя, связанного с текущей сессией.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Получить текущего пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httptransport.UserResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httptransport.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Outcome": {
            "type": "string",
            "enum": [
                "safe",
                "partial",
                "scammed"
            ],
            "x-enum-varnames": [
                "OutcomeSafe",
                "OutcomePartial",
                "OutcomeScammed"
            ]
        },
        "domain.Role": {
            "type": "string",
            "enum": [
                "buyer",
                "seller"
            ],
            "x-enum-varnames": [
                "RoleBuyer",
                "RoleSeller"
            ]
        },
        "httptransport.ChoiceRequest": {
            "type": "object",
            "required": [
                "expected_revision",
                "option_id",
                "scene_id"
            ],
            "properties": {
                "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                },
                "option_id": {
                    "type": "string"
                },
                "scene_id": {
                    "type": "string"
                }
            }
        },
        "httptransport.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "httptransport.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8
                }
            }
        },
        "httptransport.LoginResponse": {
            "type": "object",
            "properties": {
                "sessionId": {
                    "type": "string"
                }
            }
        },
        "httptransport.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "nickname",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254
                },
                "nickname": {
                    "type": "string",
                    "maxLength": 30,
                    "minLength": 3
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8
                }
            }
        },
        "httptransport.RegisterResponse": {
            "type": "object",
            "properties": {
                "sessionId": {
                    "type": "string"
                }
            }
        },
        "httptransport.StartAttemptRequest": {
            "type": "object",
            "required": [
                "scenario_id"
            ],
            "properties": {
                "scenario_id": {
                    "type": "string"
                }
            }
        },
        "httptransport.UserResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "nickname": {
                    "type": "string"
                }
            }
        },
        "httptransport.completedAttemptResultResponse": {
            "type": "object",
            "properties": {
                "attemptId": {
                    "type": "string"
                },
                "completedAt": {
                    "type": "string"
                },
                "outcome": {
                    "$ref": "#/definitions/domain.Outcome"
                },
                "score": {
                    "$ref": "#/definitions/httptransport.scoreResponse"
                }
            }
        },
        "httptransport.progressResponse": {
            "type": "object",
            "properties": {
                "completedScenarios": {
                    "type": "integer"
                },
                "completionPercent": {
                    "type": "integer"
                },
                "passedPercent": {
                    "type": "integer"
                },
                "passedScenarios": {
                    "type": "integer"
                },
                "roles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httptransport.roleProgressResponse"
                    }
                },
                "totalScenarios": {
                    "type": "integer"
                }
            }
        },
        "httptransport.roleProgressResponse": {
            "type": "object",
            "properties": {
                "completedScenarios": {
                    "type": "integer"
                },
                "completionPercent": {
                    "type": "integer"
                },
                "passedPercent": {
                    "type": "integer"
                },
                "passedScenarios": {
                    "type": "integer"
                },
                "role": {
                    "$ref": "#/definitions/domain.Role"
                },
                "scenarios": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httptransport.scenarioProgressResponse"
                    }
                },
                "totalScenarios": {
                    "type": "integer"
                }
            }
        },
        "httptransport.scenarioProgressResponse": {
            "type": "object",
            "properties": {
                "activeAttemptId": {
                    "type": "string"
                },
                "attemptsCount": {
                    "type": "integer"
                },
                "bestScore": {
                    "$ref": "#/definitions/httptransport.scoreResponse"
                },
                "completed": {
                    "type": "boolean"
                },
                "passed": {
                    "type": "boolean"
                },
                "recentAttempts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httptransport.completedAttemptResultResponse"
                    }
                },
                "scenarioSlug": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "httptransport.scoreResponse": {
            "type": "object",
            "properties": {
                "maxPoints": {
                    "type": "integer"
                },
                "percent": {
                    "type": "integer"
                },
                "points": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "SessionID": {
            "type": "apiKey",
            "name": "X-Session-ID",
            "in": "header"
        }
    }
}